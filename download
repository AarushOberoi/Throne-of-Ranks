<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Throne of Ranks</title>
  <meta name="description" content="A 3D countdown journey to JEE Main through Physics, Chemistry and Mathematics realms to NIT Tiruchirappalli." />
  <meta name="theme-color" content="#ececec" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;900&family=Cinzel+Decorative:wght@700;900&family=Alegreya:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/style.css" />
  <link rel="stylesheet" href="css/realm.css" />
  <link rel="stylesheet" href="css/minimal.css" />
</head>
<body class="theme-jee minimal">
  <div class="weather" id="weather" aria-hidden="true"></div>
  <div class="bg-fx" aria-hidden="true"><i class="orb o1"></i><i class="orb o2"></i><i class="orb o3"></i></div>

  <header class="hud" id="hud">
    <div class="brand" aria-label="Throne of Ranks by Aarush Oberoi">
      <svg class="br-logo" viewBox="0 0 32 32" aria-hidden="true"><defs><linearGradient id="brg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4fb3ff"/><stop offset=".5" stop-color="#3fe39a"/><stop offset="1" stop-color="#ffae4a"/></linearGradient></defs><g fill="none" stroke="url(#brg)" stroke-width="2"><ellipse cx="16" cy="16" rx="13" ry="5"/><ellipse cx="16" cy="16" rx="13" ry="5" transform="rotate(60 16 16)"/><ellipse cx="16" cy="16" rx="13" ry="5" transform="rotate(120 16 16)"/></g><circle cx="16" cy="16" r="3" fill="url(#brg)"/></svg>
      <span class="br-text"><span class="br-title">Throne of Ranks</span><span class="br-by">by <b>AARUSH OBEROI</b></span></span>
    </div>
    <div class="hud-badge" id="hudBadge"></div>
    <div class="hud-pills" id="hudPills"></div>
    <div class="tabs" role="tablist" aria-label="Choose goal">
      <button class="tab" role="tab" data-track="jee"><span class="tab-ico">🔥</span> JEE Main</button>
      <i class="tab-glider"></i>
    </div>
    <button class="theme-btn" id="btnTheme" type="button">☀ Day</button>
    <button class="icon-btn" id="btnSettings" aria-label="Settings"></button>
  </header>

  <main class="layout">
    <aside class="side" id="side"></aside>
    <section class="map-frame">
      <div class="map-wrap" id="mapWrap">
        <div class="map" id="map"></div>
      </div>
      <svg class="compass" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="44" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="50" cy="50" r="36" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 4"/><path d="M50 4 L57 43 L96 50 L57 57 L50 96 L43 57 L4 50 L43 43Z" fill="currentColor" opacity=".25"/><path d="M50 4 L57 43 L50 50Z M50 96 L43 57 L50 50Z M4 50 L43 43 L50 50Z M96 50 L57 57 L50 50Z" fill="currentColor"/><text x="50" y="2" text-anchor="middle" font-size="11" font-family="Cinzel,serif" font-weight="900" fill="currentColor" dy="-2">N</text></svg>
      <button class="fab" id="btnToday" aria-label="Jump to today"></button>
    </section>
  </main>

  <div class="overlay" id="dayModal" aria-hidden="true">
    <div class="sheet day-sheet" role="dialog" aria-modal="true" aria-label="Day details">
      <button class="x-btn" data-close aria-label="Close"></button>
      <div class="day-stage" id="dayStage"></div>
      <div class="day-nav">
        <button class="btn round" id="dayPrev" aria-label="Previous day"></button>
        <div class="day-nav-mid" id="dayNavMid"></div>
        <button class="btn round" id="dayNext" aria-label="Next day"></button>
      </div>
    </div>
  </div>

  <div class="overlay" id="settingsModal" aria-hidden="true">
    <div class="sheet settings-sheet" role="dialog" aria-modal="true" aria-label="Settings">
      <button class="x-btn" data-close aria-label="Close"></button>
      <div id="settingsBody"></div>
    </div>
  </div>

  <div class="overlay battle" id="battle" aria-hidden="true"></div>
  <div class="overlay evo" id="evo" aria-hidden="true"></div>

  <canvas id="confetti" aria-hidden="true"></canvas>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script src="js/data.js"></script>
  <script src="js/art.js"></script>
  <script src="js/terrain.js"></script>
  <script src="vendor/three.min.js"></script>
  <script src="js/world3d.js"></script>
  <script src="js/avatar.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
